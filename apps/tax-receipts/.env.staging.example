# Copy to .env.staging (gitignored) and fill in. Read by
# `docker compose --env-file .env.staging -f docker-compose.staging.yml ...`.
# In a managed deploy, set the same names as secrets/env on the services.

# Postgres password for the bundled `db` service.
POSTGRES_PASSWORD=

# Or point at a managed Postgres instead of the bundled `db` service:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Session signing secret, at least 32 characters: `openssl rand -base64 48`.
# Changing it logs everyone out.
SESSION_SECRET=

# The public HTTPS origin users reach the app at (used in donor email links).
PUBLIC_WEB_URL=https://tax-receipts-staging.example.org

# Optional: the party-level Qomon space (mirror sweep). Leave blank to disable.
QOMON_API_KEY=
# QOMON_API_BASE=https://incoming.qomon.app

# Email. Staging always simulates sends (EMAIL_LIVE_SENDING_ALLOWED is pinned
# to false in the compose file). `dev` is fine here; `resend` needs a key.
EMAIL_PROVIDER=dev
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# EMAIL_FROM=Green Party of Ontario <receipts@mail.example.org>

# Host port for the web container, and the image tag compose builds/pulls.
# WEB_PORT=8080
# IMAGE_TAG=staging
