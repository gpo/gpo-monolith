# nginx for the tax-receipts web image (see ../Dockerfile, target `web`).
# A template: the nginx image substitutes ${API_UPSTREAM} at container start.
#
# Serves the built SPA and proxies /api/* to the Fastify API with the /api
# prefix stripped, the same contract as the Vite dev proxy (vite.config.ts).

# Keep the original scheme from the load balancer, so the API (TRUST_PROXY)
# sees https and sets its Secure session cookie.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # headroom over the 1 MB default for admin imports
  client_max_body_size 20m;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  # trailing slashes on both sides strip the /api prefix
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    # print batches and receipt PDFs are generated on request
    proxy_read_timeout 300s;
  }

  # Vite fingerprints everything under /assets/
  location /assets/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # client-side routes (TanStack Router) fall back to index.html
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
