// Tax Receipts & Contributions tool - Prisma schema v1 (ticket 0.2).
//
// All 20 entities from data-model.md §2, plus the ReconciliationMark <->
// Contribution join (ReconciliationMatch) the doc calls for, plus three
// Phase-0 infrastructure tables that are not domain entities and are called
// out in PHASE-0-NOTES.md: IssuanceKillSwitch (ticket 0.5, EFA s.25.1(7)),
// BusinessDayCalendar (ticket 0.10, the RTD holiday config), and Session
// (stateful auth sessions, ticket 0.5).
//
// Conventions: money is integer cents; timestamps are UTC (EO-facing
// evaluation converts to America/Toronto, see tax-receipts-core). Names and
// relations follow data-model.md §2 exactly.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirror packages/tax-receipts-core/src/enums.ts; a test asserts parity)
// ---------------------------------------------------------------------------

enum EntityKind {
  CA
  CAMPAIGN
  PARTY
}

enum ReceivedBy {
  GPO
  ENTITY
}

enum ReceiptStatus {
  ISSUED
  CANCELLED
  VOID
}

enum ReceiptDelivery {
  EMAIL
  MAIL
}

/// what an outgoing email carries (ticket 3.6)
enum EmailPurpose {
  RECEIPT
  PRECHECK
}

/// an outgoing email's lifecycle (ticket 3.6). QUEUED -> SENDING -> SENT is
/// the dispatcher's; DELIVERED, DELAYED, BOUNCED, COMPLAINED arrive from the
/// provider's webhook. FAILED is a send the provider refused or that ran out
/// of retries. BOUNCED and FAILED are undeliverable.
enum EmailStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  DELAYED
  BOUNCED
  COMPLAINED
  FAILED
}

/// why a stored receipt PDF was reproduced without cancelling the receipt
enum ReceiptReprintKind {
  /// a lost receipt reprinted unaltered and stamped COPY (EO status L)
  LOST_COPY
  /// a non-material spelling fix (corrections.md action 3)
  CORRECTED
}

enum ReceiptNumberSource {
  SEQUENCE
  FOREIGN
}

enum PeriodKind {
  ANNUAL
  GENERAL_ELECTION
  BY_ELECTION
}

enum PaymentSource {
  QOMON_IMPORT
  MANUAL
  LEGACY_IMPORT
}

enum PaymentMethod {
  CARD
  CHEQUE
  CASH
  PAD
  EFT
  IN_KIND
  OTHER
}

enum PaymentState {
  RECEIVED
  UNPAID
  REFUNDED
  BANK_ERROR
  OTHER
}

enum ContributionStatus {
  ACTIVE
  SUPERSEDED
  REFUNDED
}

enum ContributionLimitBucket {
  PARTY
  CA
  CAMPAIGN
  LEADERSHIP
  CANDIDATE_SELF
}

enum WorkItemKind {
  VALIDATION
  DIFF
  OWED_TO_EO
  SYNC_INCIDENT
  /// a receipt email that bounced or failed; the receipt has been moved to
  /// MAIL and needs to go out in a print batch (ticket 3.6)
  DELIVERY
}

enum WorkItemStatus {
  OPEN
  RESOLVED
  EXCEPTION
}

enum RtdFilingKind {
  INITIAL
  DC1A_AMENDMENT
}

enum RtdFilingFormat {
  CSV
  PIPE
}

enum EntityReportKind {
  ALL
  S2P2
}

enum EOFormKind {
  CANCELLATION
  DC1
  DC1A
  OTHER
}

enum ArtifactKind {
  PDF
  CSV
  FORM
}

enum ReconciliationMarkKind {
  PAYOUT
  BANK_DEPOSIT
  TRANSFER
}

enum SpaceStage {
  intake
  queue_clear
  reconciled
  issued
  delivered
  reported
  sent_to_cfo
}

enum UserRole {
  sysadmin
  party_cfo
  administrator
  rules_authority
  bookkeeper
  filer
  process_owner
  organizer
  cfo
  readonly
}

enum ChangeLogSubjectType {
  Payment
  Contribution
  /// legacy: historical change-log rows only; since D12 the descriptive
  /// fields live on Contribution and are logged as Contribution
  ContributionMetadata
  Contact
  AddressSnapshot
  Receipt
  ReceiptAllocation
  RtdFiling
  RtdInclusion
  EntityReport
  EOForm
  WorkItem
  Period
  ContributionLimit
  DonorCyclePreference
  SpaceState
  ReconciliationMark
  User
  IssuanceKillSwitch
}

// ---------------------------------------------------------------------------
// Financial core
// ---------------------------------------------------------------------------

model Contact {
  id             String    @id @default(cuid())
  /// null only in development and testing (D12): before go-live a contact needs
  /// a Qomon link before a contribution can be attributed to it (invariant 9).
  qomonContactId BigInt?   @unique
  name           String
  /// Qomon's separate firstname/surname (ticket 4.1: the ALL/S2P2 EO reports
  /// need first and last name as distinct columns, which `name` cannot supply
  /// once joined; null when Qomon has no name split, e.g. an org-only contact)
  firstName      String?
  lastName       String?
  email          String?
  /// full mailing address as last synced from Qomon (JSON blob)
  addresses      Json      @default("[]")
  lastSyncedAt   DateTime?
  /// hash over amount/date/contact-relevant fields for cheap drift detection
  syncHash       String?
  /// set when a duplicate was merged into another contact (corrections.md
  /// action 10); the record stays, pointing at the survivor
  mergedIntoId   String?
  mergedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  mergedInto       Contact?               @relation("ContactMerge", fields: [mergedIntoId], references: [id])
  mergedFrom       Contact[]              @relation("ContactMerge")
  addressSnapshots AddressSnapshot[]
  payments         Payment[]
  contributions    Contribution[]
  receipts         Receipt[]
  workItems        WorkItem[]
  emailMessages    EmailMessage[]
  cyclePreferences DonorCyclePreference[]

  @@index([mergedIntoId])
  @@map("contact")
}

model AddressSnapshot {
  id         String   @id @default(cuid())
  contactId  String
  periodId   Int
  /// address fields captured at the time the snapshot was taken
  line1      String
  line2      String?
  city       String
  province   String
  postalCode String
  country    String   @default("CA")
  /// where the address came from (e.g. "period-63", "donor-precheck", "qomon")
  source     String
  capturedAt DateTime @default(now())

  contact  Contact   @relation(fields: [contactId], references: [id])
  period   Period    @relation(fields: [periodId], references: [id])
  receipts Receipt[]

  @@index([contactId, periodId])
  @@map("address_snapshot")
}

/// The money event (data-model §2, D12): what was received, when, and how.
/// Tool-owned: entered manually or imported once from a Qomon transaction.
/// One payment carries one or more contributions (a split). Nothing
/// EO-facing lives here; attribution is on Contribution.
model Payment {
  id              String        @id @default(cuid())
  source          PaymentSource
  /// who paid, as recorded; never null (invariant 9)
  contactId       String
  amountCents     Int
  currency        String        @default("cad")
  receivedAt      DateTime
  method          PaymentMethod
  /// structured payer when it differs from the contact (rule B5, O36)
  payerName       String?
  /// processor id string, for statement matching
  externalRef     String?
  state           PaymentState  @default(RECEIVED)
  note            String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contact       Contact               @relation(fields: [contactId], references: [id])
  createdBy     User?                 @relation(fields: [createdByUserId], references: [id])
  contributions Contribution[]
  qomonLink     QomonTransactionLink?

  @@index([contactId])
  @@index([receivedAt])
  @@index([externalRef])
  @@map("payment")
}

/// Import provenance only (D12): which Qomon transaction a payment was
/// created from, and what the sweep last saw. Absent for MANUAL and
/// LEGACY_IMPORT payments. Never read back as attribution.
model QomonTransactionLink {
  id                     String    @id @default(cuid())
  paymentId              String    @unique
  qomonTransactionId     BigInt    @unique
  qomonBundleId          BigInt?
  /// Qomon's raw `payment_method_kind` and `code_campaign` at import
  qomonPaymentMethodKind String?
  codeCampaign           String?
  firstSeenAt            DateTime  @default(now())
  lastSyncedAt           DateTime?
  /// hash over the Qomon transaction's facts as last seen, for cheap change
  /// detection (a change opens a sync incident and mutates nothing, O47)
  syncHash               String?
  /// set, never deleted (invariant 4): a transaction absent from Qomon
  deletedInQomonAt       DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("qomon_transaction_link")
}

/// The tax attribution of (part of) a payment (data-model §2, D12).
/// Versioned: once an allocation or RTD inclusion references it, a
/// correction closes the row as SUPERSEDED and opens its replacements.
model Contribution {
  id            String             @id @default(cuid())
  paymentId     String
  contactId     String
  amountCents   Int
  /// acceptance date (drives everything EO); defaults from the payment's receivedAt
  acceptedAt    DateTime
  status        ContributionStatus @default(ACTIVE)
  /// the row this one replaced, when a correction created it
  supersedesId  String?
  /// one guarded action's cascade shares a correlation id
  correlationId String?
  note          String?

  // --- descriptive fields (data-model §3; folded in from ContributionMetadata, D12) ---
  /// null until a reporting period resolves (data-model §6: never from a Qomon
  /// default): a row with no period is awaiting intake derivation and belongs
  /// to no processing space.
  periodId           Int?
  /// null = party-level (no riding)
  ridingNumber       Int?
  entityKind         EntityKind @default(PARTY)
  receivedBy         ReceivedBy @default(GPO)
  goodsServices      Boolean    @default(false)
  nonDeductibleCents Int        @default(0)
  /// accounting date when it differs from the acceptance date
  processedDate      DateTime?
  sourceCode         String     @default("")
  eoContributorId    String?
  exceptionReason    String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payment               Payment               @relation(fields: [paymentId], references: [id])
  period                Period?               @relation(fields: [periodId], references: [id])
  contact               Contact               @relation(fields: [contactId], references: [id])
  createdBy             User?                 @relation(fields: [createdByUserId], references: [id])
  supersedes            Contribution?         @relation("ContributionSupersedes", fields: [supersedesId], references: [id])
  supersededBy          Contribution[]        @relation("ContributionSupersedes")
  allocations           ReceiptAllocation[]
  rtdInclusions         RtdInclusion[]
  reconciliationMatches ReconciliationMatch[]

  @@index([paymentId])
  @@index([contactId])
  @@index([acceptedAt])
  @@index([status])
  @@index([periodId])
  @@index([ridingNumber, entityKind])
  @@map("contribution")
}

model ReceiptSequence {
  /// one row per prefix (e.g. "GPO-")
  prefix    String   @id
  /// last number issued; next issuance is counter + 1 (invariant 3)
  counter   Int
  updatedAt DateTime @updatedAt

  @@map("receipt_sequence")
}

model Receipt {
  id                  String              @id @default(cuid())
  receiptNumber       String              @unique
  numberSource        ReceiptNumberSource @default(SEQUENCE)
  status              ReceiptStatus       @default(ISSUED)
  /// EO status L; reprints are stamped "Copy"
  lost                Boolean             @default(false)
  replacedById        String?             @unique
  /// a split reissues one cancelled receipt as several, so this is not unique;
  /// replacedById names the primary replacement
  reissuedFromId      String?
  ridingNumber        Int?
  entityKind          EntityKind
  periodId            Int
  issueDate           DateTime
  contactId           String
  contactNameSnapshot String
  addressSnapshotId   String
  delivery            ReceiptDelivery     @default(MAIL)
  deliveredAt         DateTime?
  pdfArtifactId       String?
  createdAt           DateTime            @default(now())
  // NOTE: no `total` column - a receipt total is always derived from its
  // allocations (invariant 2).

  period            Period                @relation(fields: [periodId], references: [id])
  contact           Contact               @relation(fields: [contactId], references: [id])
  addressSnapshot   AddressSnapshot       @relation(fields: [addressSnapshotId], references: [id])
  replacedBy        Receipt?              @relation("ReceiptReplacement", fields: [replacedById], references: [id])
  replaces          Receipt?              @relation("ReceiptReplacement")
  reissuedFrom      Receipt?              @relation("ReceiptReissue", fields: [reissuedFromId], references: [id])
  reissues          Receipt[]             @relation("ReceiptReissue")
  pdfArtifact       Artifact?             @relation(fields: [pdfArtifactId], references: [id])
  allocations       ReceiptAllocation[]
  entityReportLinks EntityReportReceipt[]
  eoForms           EOForm[]
  reprints          ReceiptReprint[]
  emailMessages     EmailMessage[]
  printBatchItems   PrintBatchItem[]

  @@index([periodId])
  @@index([contactId])
  @@index([status])
  @@index([reissuedFromId])
  @@map("receipt")
}

/// A reproduction of an issued receipt's PDF that does not touch the receipt
/// (its own PDF and fields are frozen, invariant 7): the lost-receipt Copy and
/// the typo-only lightweight reprint (corrections.md action 3).
model ReceiptReprint {
  id              String             @id @default(cuid())
  receiptId       String
  kind            ReceiptReprintKind
  /// the corrected spelling printed on a CORRECTED reprint
  correctedName   String?
  artifactId      String
  reason          String
  createdByUserId String?
  createdAt       DateTime           @default(now())

  receipt  Receipt  @relation(fields: [receiptId], references: [id])
  artifact Artifact @relation(fields: [artifactId], references: [id])

  @@index([receiptId])
  @@map("receipt_reprint")
}

model ReceiptAllocation {
  id             String   @id @default(cuid())
  receiptId      String
  contributionId String
  amountCents    Int
  createdAt      DateTime @default(now())

  receipt      Receipt      @relation(fields: [receiptId], references: [id])
  contribution Contribution @relation(fields: [contributionId], references: [id])

  @@unique([receiptId, contributionId])
  @@index([contributionId])
  @@map("receipt_allocation")
}

model Period {
  /// EO period id (63, 64, 67, ...)
  id            Int        @id
  name          String
  kind          PeriodKind
  /// by-elections: EO can run concurrent by-elections and one EO period may
  /// cover several ridings; empty for party-wide ANNUAL / GENERAL_ELECTION
  ridingNumbers Int[]      @default([])
  /// minute-precision boundaries, stored UTC. Editable; an edit re-runs A1.
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  contributions         Contribution[]
  addressSnapshots      AddressSnapshot[]
  receipts              Receipt[]
  entityReports         EntityReport[]
  spaceStates           SpaceState[]
  donorCyclePreferences DonorCyclePreference[]
  printBatches          PrintBatch[]

  @@map("period")
}

model ContributionLimit {
  id          String                  @id @default(cuid())
  year        Int
  bucket      ContributionLimitBucket
  amountCents Int
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([year, bucket])
  @@map("contribution_limit")
}

model RtdInclusion {
  id                  String   @id @default(cuid())
  contributionId      String
  rtdFilingId         String
  amountCents         Int
  /// contributor aggregate year-to-date after this deposit
  aggregateAfterCents Int
  createdAt           DateTime @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id])
  rtdFiling    RtdFiling    @relation(fields: [rtdFilingId], references: [id])

  @@index([contributionId])
  @@index([rtdFilingId])
  @@map("rtd_inclusion")
}

model RtdFiling {
  id             String          @id @default(cuid())
  /// the EO filename, <Year>_RTD_<PartyID>_MMDDYYYYHHMM
  name           String          @unique
  kind           RtdFilingKind   @default(INITIAL)
  format         RtdFilingFormat @default(CSV)
  generatedAt    DateTime        @default(now())
  submittedAt    DateTime?
  submittedBy    String?
  artifactId     String?
  amendsFilingId String?

  artifact     Artifact?      @relation(fields: [artifactId], references: [id])
  amendsFiling RtdFiling?     @relation("RtdAmendment", fields: [amendsFilingId], references: [id])
  amendedBy    RtdFiling[]    @relation("RtdAmendment")
  inclusions   RtdInclusion[]
  eoForms      EOForm[]

  @@map("rtd_filing")
}

model EntityReport {
  id             String           @id @default(cuid())
  /// null on both ridingNumber and entityKind together = the combined,
  /// all-entities file EO also expects alongside the per-entity ones
  /// (eo-reporting.md §2, ticket 4.1); a non-null entityKind (ridingNumber
  /// null only for PARTY) is one entity's own file, e.g. for its CFO.
  ridingNumber   Int?
  entityKind     EntityKind?
  periodId       Int
  kind           EntityReportKind
  generatedAt    DateTime         @default(now())
  artifactId     String?
  /// the receipt + contribution set this report included, recorded as a
  /// point-in-time snapshot (data-model §2 "included_set (recorded)")
  includedSet    Json             @default("{}")
  sentToCfoAt    DateTime?
  /// set when this report went into a filed annual return; a later correction to
  /// a receipt it covers then owes the current year's return a note (corrections.md)
  filedAt        DateTime?
  supersededById String?          @unique
  dirty          Boolean          @default(false)

  period       Period                @relation(fields: [periodId], references: [id])
  artifact     Artifact?             @relation(fields: [artifactId], references: [id])
  supersededBy EntityReport?         @relation("EntityReportSupersede", fields: [supersededById], references: [id])
  supersedes   EntityReport?         @relation("EntityReportSupersede")
  receiptLinks EntityReportReceipt[]

  @@index([periodId, ridingNumber, entityKind])
  @@map("entity_report")
}

/// EntityReport <-> Receipt: which receipts a generated report covered.
model EntityReportReceipt {
  entityReportId String
  receiptId      String

  entityReport EntityReport @relation(fields: [entityReportId], references: [id])
  receipt      Receipt      @relation(fields: [receiptId], references: [id])

  @@id([entityReportId, receiptId])
  @@map("entity_report_receipt")
}

model EOForm {
  id          String     @id @default(cuid())
  kind        EOFormKind
  /// "receipt" | "filing"
  subject     String
  receiptId   String?
  rtdFilingId String?
  artifactId  String?
  filedAt     DateTime?
  createdAt   DateTime   @default(now())

  receipt   Receipt?   @relation(fields: [receiptId], references: [id])
  rtdFiling RtdFiling? @relation(fields: [rtdFilingId], references: [id])
  artifact  Artifact?  @relation(fields: [artifactId], references: [id])

  @@map("eo_form")
}

model ChangeLogEntry {
  id            String               @id @default(cuid())
  subjectType   ChangeLogSubjectType
  subjectId     String
  actorUserId   String?
  /// mandatory (invariant 5)
  reason        String
  before        Json?
  after         Json?
  at            DateTime             @default(now())
  /// one guarded action's cascade shares a correlation id
  correlationId String

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([subjectType, subjectId])
  @@index([correlationId])
  @@index([at])
  @@map("change_log_entry")
}

model Artifact {
  id        String       @id @default(cuid())
  kind      ArtifactKind
  /// storage pointer (object key / path); the bytes live in object storage
  uri       String
  sha256    String
  byteSize  Int?
  createdAt DateTime     @default(now())
  // retained >= 6 years; never hard-deleted

  receipts        Receipt[]
  rtdFilings      RtdFiling[]
  entityReports   EntityReport[]
  eoForms         EOForm[]
  workItems       WorkItem[]
  receiptReprints ReceiptReprint[]
  printBatches    PrintBatch[]

  @@map("artifact")
}

// ---------------------------------------------------------------------------
// Operational entities
// ---------------------------------------------------------------------------

model WorkItem {
  id             String               @id @default(cuid())
  kind           WorkItemKind
  subjectType    ChangeLogSubjectType
  subjectId      String
  /// the donor, denormalized for queue views
  contactId      String?
  ruleRef        String?
  dueAt          DateTime?
  status         WorkItemStatus       @default(OPEN)
  assigneeUserId String?
  resolutionNote String?
  formArtifactId String?
  /// multi-contribution findings share a correlation id
  correlationId  String?
  openedAt       DateTime             @default(now())
  closedAt       DateTime?

  contact      Contact?  @relation(fields: [contactId], references: [id])
  assignee     User?     @relation(fields: [assigneeUserId], references: [id])
  formArtifact Artifact? @relation(fields: [formArtifactId], references: [id])

  @@index([kind, status])
  @@index([subjectType, subjectId])
  @@index([correlationId])
  @@map("work_item")
}

model DonorCyclePreference {
  id                         String          @id @default(cuid())
  contactId                  String
  year                       Int
  /// default MAIL until confirmed
  delivery                   ReceiptDelivery @default(MAIL)
  precheckSentAt             DateTime?
  addressConfirmedAt         DateTime?
  /// bearer token for the donor-facing confirm link (ticket 3.9); cleared
  /// once used, so a stale/replayed link 404s rather than re-confirming
  confirmationToken          String?         @unique
  confirmationTokenExpiresAt DateTime?
  /// which space's send this outstanding token belongs to, so confirming it
  /// files the resulting AddressSnapshot under the right period; cleared
  /// alongside the token
  confirmationPeriodId       Int?
  updatedAt                  DateTime        @updatedAt

  contact            Contact @relation(fields: [contactId], references: [id])
  confirmationPeriod Period? @relation(fields: [confirmationPeriodId], references: [id])

  @@unique([contactId, year])
  @@map("donor_cycle_preference")
}

model SpaceState {
  id           String     @id @default(cuid())
  periodId     Int
  ridingNumber Int?
  entityKind   EntityKind
  /// the W6 ladder
  stage        SpaceStage @default(intake)
  stageOwner   String?
  updatedAt    DateTime   @updatedAt

  period Period @relation(fields: [periodId], references: [id])

  @@unique([periodId, ridingNumber, entityKind])
  @@map("space_state")
}

model ReconciliationMark {
  id                 String                 @id @default(cuid())
  /// statement identity: processor payout id, bank deposit ref, transfer batch
  externalRef        String
  kind               ReconciliationMarkKind
  statementDate      DateTime
  amountCentsMatched Int
  createdBy          String
  createdAt          DateTime               @default(now())
  note               String?

  matches ReconciliationMatch[]

  @@index([externalRef])
  @@map("reconciliation_mark")
}

/// ReconciliationMark <-> Contribution (data-model §2: "contribution ids
/// matched (join table)"). The 21st entity.
model ReconciliationMatch {
  id                   String   @id @default(cuid())
  reconciliationMarkId String
  contributionId       String
  createdAt            DateTime @default(now())

  reconciliationMark ReconciliationMark @relation(fields: [reconciliationMarkId], references: [id])
  contribution       Contribution       @relation(fields: [contributionId], references: [id])

  @@unique([reconciliationMarkId, contributionId])
  @@index([contributionId])
  @@map("reconciliation_match")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(readonly)
  active         Boolean  @default(true)
  /// authorized RTD-submission designate (Form DC-1)
  isCfoDesignate Boolean  @default(false)
  /// per-riding grants (data-model §2: CASL keys off role + per-riding grants)
  ridingGrants   Int[]    @default([])
  /// central staff see every riding
  allRidings     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  changeLogEntries     ChangeLogEntry[]
  assignedWorkItems    WorkItem[]
  sessions             Session[]
  paymentsCreated      Payment[]
  contributionsCreated Contribution[]

  @@map("app_user")
}

// ---------------------------------------------------------------------------
// Phase-0 infrastructure (not data-model §2 entities; see PHASE-0-NOTES.md)
// ---------------------------------------------------------------------------

/// EFA s.25.1(7): the party CFO must be able to immediately cease issuing on
/// the CEO's request. Singleton row (id = "singleton"). Checked at every
/// issuance path (ticket 0.5).
model IssuanceKillSwitch {
  id        String    @id @default("singleton")
  engaged   Boolean   @default(false)
  engagedAt DateTime?
  engagedBy String?
  reason    String?
  updatedAt DateTime  @updatedAt

  @@map("issuance_kill_switch")
}

/// The nine ESA holidays for a calendar year, as ET ISO dates. Annual
/// configuration, not code (ticket 0.10). Editable.
model BusinessDayCalendar {
  year      Int      @id
  /// ISO YYYY-MM-DD strings
  holidays  String[]
  updatedAt DateTime @updatedAt

  @@map("business_day_calendar")
}

/// Mirror-sweep resume cursor, one row per ChangeFeedSource (ticket 1.1;
/// qomon-client's `ChangeCursor`). Not a data-model §2 entity: it is sync
/// bookkeeping, in the same vein as the three Phase-0 infra tables above.
model SyncCursor {
  /// the feed's `kind`, e.g. "qomon-poll" (qomon-client ChangeFeedSource)
  feedKind  String   @id
  /// ISO timestamp of the newest record ingested so far, or null (never run)
  since     String?
  token     String?
  updatedAt DateTime @updatedAt

  @@map("sync_cursor")
}

/// A riding-specific Qomon space (some ridings run their own Qomon account,
/// separate from the party-level space configured by QOMON_API_KEY). One row
/// per riding that needs its own credentials; a riding absent here has no
/// space of its own and isn't sweepable individually. Not a data-model §2
/// entity: sync bookkeeping/config, in the same vein as SyncCursor above.
model Riding {
  /// Ontario provincial riding number (1-124)
  ridingNumber Int      @id
  name         String
  qomonApiKey  String
  /// overrides the default QOMON_API_BASE when this riding's space lives on
  /// a different host; null uses the default.
  qomonApiBase String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("riding")
}

/// Stateful auth session store (ticket 0.5). Backs @fastify/session.
model Session {
  sid       String   @id
  data      Json
  expiresAt DateTime
  userId    String?

  user User? @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@map("session")
}

// ---------------------------------------------------------------------------
// Delivery (ticket 3.6)
// ---------------------------------------------------------------------------

/// One outgoing email: the outbox row the dispatcher sends from and the
/// record of what was sent. The content is stored as sent, so the row is the
/// audit copy. Never hard-deleted.
model EmailMessage {
  id                String       @id @default(cuid())
  purpose           EmailPurpose
  /// set for RECEIPT emails
  receiptId         String?
  contactId         String
  toAddress         String
  subject           String
  textBody          String
  htmlBody          String?
  /// [{ artifactId, filename }], attached in order
  attachments       Json         @default("[]")
  status            EmailStatus  @default(QUEUED)
  statusDetail      String?
  /// the adapter that sent it (e.g. "resend", "dev")
  provider          String?
  providerMessageId String?      @unique
  attempts          Int          @default(0)
  nextAttemptAt     DateTime     @default(now())
  /// set while a dispatcher holds the row (status SENDING)
  claimedAt         DateTime?
  queuedByUserId    String?
  queuedAt          DateTime     @default(now())
  sentAt            DateTime?
  lastEventAt       DateTime?

  receipt Receipt?     @relation(fields: [receiptId], references: [id])
  contact Contact      @relation(fields: [contactId], references: [id])
  events  EmailEvent[]

  @@index([status, nextAttemptAt])
  @@index([receiptId])
  @@map("email_message")
}

/// A provider webhook event, append-only. `providerEventId` dedupes the
/// provider's at-least-once redelivery.
model EmailEvent {
  id              String   @id @default(cuid())
  emailMessageId  String
  providerEventId String   @unique
  type            String
  occurredAt      DateTime
  detail          String?
  payload         Json
  receivedAt      DateTime @default(now())

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id])

  @@index([emailMessageId])
  @@map("email_event")
}

/// One print run for a space: the consolidated PDF (a cover letter and the
/// receipt for each MAIL receipt) and, once someone confirms it went in the
/// post, `mailedAt`. Marking it mailed is what sets `Receipt.deliveredAt` for
/// mail. Never hard-deleted.
model PrintBatch {
  id              String     @id @default(cuid())
  periodId        Int
  ridingNumber    Int?
  entityKind      EntityKind
  artifactId      String
  createdByUserId String
  createdAt       DateTime   @default(now())
  mailedAt        DateTime?
  mailedByUserId  String?

  period   Period           @relation(fields: [periodId], references: [id])
  artifact Artifact         @relation(fields: [artifactId], references: [id])
  items    PrintBatchItem[]

  @@index([periodId, ridingNumber, entityKind])
  @@map("print_batch")
}

model PrintBatchItem {
  id           String @id @default(cuid())
  printBatchId String
  receiptId    String
  /// page order in the batch PDF
  position     Int

  printBatch PrintBatch @relation(fields: [printBatchId], references: [id])
  receipt    Receipt    @relation(fields: [receiptId], references: [id])

  @@unique([printBatchId, receiptId])
  @@index([receiptId])
  @@map("print_batch_item")
}
