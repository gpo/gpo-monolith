# Copy to .env for local dev. CI sets these from a Postgres service container.
# Dev data lives in a separate, persistent database (docker-compose.dev.yml,
# `pnpm db:dev:up`) from the one `pnpm test` truncates on every run
# (docker-compose.test.yml, :5433, tmpfs) — don't point this at :5433.
DATABASE_URL="postgresql://gpo:gpo@localhost:5434/tax_receipts_dev?schema=public"

# Session signing secret (any long random string for local dev).
SESSION_SECRET="dev-only-session-secret-change-me-01234567890123456789"

# Qomon sandbox (never commit a real key; see ../../../qomon-test/.env).
# QOMON_API_KEY=""
# QOMON_API_BASE="https://incoming.qomon.app"

# Email delivery (ticket 3.6). `dev` sends nothing: the outbox under
# Admin > Dev tools is the record, and it can simulate delivered/bounced.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# RESEND_WEBHOOK_SECRET="whsec_..."   # webhook endpoint: POST /webhooks/email
# EMAIL_FROM="Green Party of Ontario <receipts@mail.example.org>"
# EMAIL_REPLY_TO=""
# EMAIL_RATE_PER_SECOND=5
# EMAIL_DAILY_LIMIT=               # set while warming up a new sending domain
# PUBLIC_WEB_URL="http://localhost:5173"
